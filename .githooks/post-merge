#!/bin/sh
# After a merge (e.g. promoting a project from dev to master), regenerate the solution on master.
# Install: git config core.hooksPath .githooks
# We always exit 0 so a script failure never blocks the merge.
cd "$(git rev-parse --show-toplevel)" && powershell.exe -NoProfile -ExecutionPolicy Bypass -File "d:/mcp/oni-serena/scripts/regenerate-solution.ps1" -OnlyIfMaster
exit 0
