<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Based on BlankProject template.
    SDK, publicize, ILRepack, deploy, and version increment are via Directory.Build.props/targets.
  -->

  <PropertyGroup>
    <AssemblyName>ControlledAssignments</AssemblyName>
    <RootNamespace>ControlledAssignments</RootNamespace>
  </PropertyGroup>

  <!-- Optional preview.jpg (add file yourself); preview.png supported via Directory.Build.props -->
  <ItemGroup>
    <Content Include="preview.jpg" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(MSBuildProjectDirectory)\preview.jpg')" />
  </ItemGroup>

</Project>
