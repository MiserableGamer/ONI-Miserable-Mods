<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CopyMaterialsTool</AssemblyName>
    <RootNamespace>CopyMaterials</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultItems>true</EnableDefaultItems>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- NuGet Packages -->
  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
    <PackageReference Include="ILRepack" Version="2.0.34" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" PrivateAssets="all" />
    <PackageReference Include="PLib" Version="4.19.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game References -->
  <ItemGroup>
    <Reference Include="0Harmony" HintPath="..\lib\0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="..\lib\Assembly-CSharp.dll" Private="false" Publicize="true" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="..\lib\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="..\lib\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="..\lib\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="..\lib\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="..\lib\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="..\lib\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="..\lib\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="..\lib\UnityEngine.InputLegacyModule.dll" Private="false" />
  </ItemGroup>

  <!-- Content files -->
  <ItemGroup>
    <None Remove="mod.yaml" />
    <None Remove="mod_info.yaml" />
    <Content Include="mod.yaml" CopyToOutputDirectory="Always" />
    <Content Include="mod_info.yaml" CopyToOutputDirectory="Always" />
    <Content Include="preview.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('preview.png')" />
  </ItemGroup>

  <!-- Pre-build: Version increment -->
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(SolutionDir)increment_version.ps1&quot; -ProjectDir &quot;$(ProjectDir)&quot;" ContinueOnError="true" />
  </Target>

  <!-- Post-build: ILRepack and Deploy -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <PropertyGroup>
      <LocalModFolder>C:\Users\Leomo\Documents\Klei\OxygenNotIncluded\mods\Local\CopyMaterialsTool\</LocalModFolder>
      <NetworkModFolder>\\192.168.1.30\development\ONI\Mods\ONI Miserable Mods\CopyMaterialsTool\</NetworkModFolder>
    </PropertyGroup>

    <!-- ILRepack: Merge PLib into main DLL -->
    <Exec Command="&quot;$(NuGetPackageRoot)ilrepack\2.0.34\tools\ILRepack.exe&quot; /ndebug /lib:&quot;$(SolutionDir)lib&quot; /lib:&quot;$(NuGetPackageRoot)newtonsoft.json\13.0.4\lib\net45&quot; /out:&quot;$(TargetDir)$(TargetFileName).merged&quot; &quot;$(TargetPath)&quot; &quot;$(TargetDir)PLib.dll&quot;" Condition="Exists('$(TargetDir)PLib.dll')" ContinueOnError="true" />
    <Delete Files="$(TargetPath)" Condition="Exists('$(TargetDir)$(TargetFileName).merged')" />
    <Move SourceFiles="$(TargetDir)$(TargetFileName).merged" DestinationFiles="$(TargetPath)" Condition="Exists('$(TargetDir)$(TargetFileName).merged')" />
    <Delete Files="$(TargetDir)PLib.dll" Condition="Exists('$(TargetDir)PLib.dll')" />

    <!-- Deploy to Local mods folder -->
    <MakeDir Directories="$(LocalModFolder)" Condition="!Exists('$(LocalModFolder)')" />
    <Copy SourceFiles="$(ProjectDir)mod.yaml" DestinationFolder="$(LocalModFolder)" />
    <Copy SourceFiles="$(ProjectDir)mod_info.yaml" DestinationFolder="$(LocalModFolder)" />
    <Copy SourceFiles="$(ProjectDir)preview.png" DestinationFolder="$(LocalModFolder)" Condition="Exists('$(ProjectDir)preview.png')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(LocalModFolder)" />

    <!-- Deploy to Network share -->
    <Copy SourceFiles="$(ProjectDir)mod.yaml" DestinationFolder="$(NetworkModFolder)" />
    <Copy SourceFiles="$(ProjectDir)mod_info.yaml" DestinationFolder="$(NetworkModFolder)" />
    <Copy SourceFiles="$(ProjectDir)preview.png" DestinationFolder="$(NetworkModFolder)" Condition="Exists('$(ProjectDir)preview.png')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NetworkModFolder)" />

    <!-- Cleanup unwanted files -->
    <Delete Files="$(LocalModFolder)PLib.dll" Condition="Exists('$(LocalModFolder)PLib.dll')" />
    <Delete Files="$(NetworkModFolder)PLib.dll" Condition="Exists('$(NetworkModFolder)PLib.dll')" />
  </Target>

</Project>
