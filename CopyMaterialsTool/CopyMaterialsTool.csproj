<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CopyMaterialsTool</AssemblyName>
    <RootNamespace>CopyMaterials</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultItems>true</EnableDefaultItems>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- NuGet Packages -->
  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
    <PackageReference Include="ILRepack" Version="2.0.34" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" PrivateAssets="all" />
    <PackageReference Include="PLib" Version="4.19.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game References -->
  <ItemGroup>
    <Reference Include="0Harmony" HintPath="..\lib\0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="..\lib\Assembly-CSharp.dll" Private="false" Publicize="true" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="..\lib\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="..\lib\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="..\lib\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="..\lib\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="..\lib\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="..\lib\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="..\lib\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="..\lib\UnityEngine.InputLegacyModule.dll" Private="false" />
  </ItemGroup>

  <!-- Content files -->
  <ItemGroup>
    <None Remove="mod.yaml" />
    <None Remove="mod_info.yaml" />
    <Content Include="mod.yaml" CopyToOutputDirectory="Always" />
    <Content Include="mod_info.yaml" CopyToOutputDirectory="Always" />
    <Content Include="preview.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('preview.png')" />
  </ItemGroup>

  <!-- Version increment and deploy to mods/local: Directory.Build.targets (development only). ILRepack: Directory.Build.targets. -->

</Project>
