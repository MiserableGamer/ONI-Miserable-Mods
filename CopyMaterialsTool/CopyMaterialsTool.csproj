<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CopyMaterialsTool</AssemblyName>
    <RootNamespace>CopyMaterials</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultItems>true</EnableDefaultItems>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- NuGet packages and game refs: Directory.Build.props -->

  <!-- Content files -->
  <ItemGroup>
    <None Remove="mod.yaml" />
    <None Remove="mod_info.yaml" />
    <Content Include="mod.yaml" CopyToOutputDirectory="Always" />
    <Content Include="mod_info.yaml" CopyToOutputDirectory="Always" />
    <Content Include="preview.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('preview.png')" />
  </ItemGroup>

  <!-- Version increment and deploy to mods/local: Directory.Build.targets (development only). ILRepack: Directory.Build.targets. -->

</Project>
