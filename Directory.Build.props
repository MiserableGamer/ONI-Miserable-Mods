<Project>
  <!-- 
    Shared build properties for all ONIMiserableMods projects.
    Individual projects only need to define AssemblyName and RootNamespace.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultItems>true</EnableDefaultItems>
    <DebugType>portable</DebugType>
    <!-- Force all build output into the project directory, not the solution root -->
    <BaseOutputPath>$(MSBuildProjectDirectory)\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <!-- Debug configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <!-- Release configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- NuGet Packages (shared across all projects). Exclude SteamWorkshopUploader (standalone tool). -->
  <ItemGroup Condition="'$(UsingMicrosoftNETSdk)' == 'true' and '$(MSBuildProjectName)' != 'SteamWorkshopUploader'">
    <PackageReference Include="ILRepack" Version="2.0.34" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" PrivateAssets="all" />
    <PackageReference Include="PLib" Version="4.19.0" PrivateAssets="all" />
  </ItemGroup>
  <!-- Must run on Core MSBuild too (`dotnet build`); otherwise Publicize="true" is ignored and
       overrides see protected base members while the IDE (Full MSBuild) publicizes → CS0507 mismatch. -->
  <ItemGroup Condition="'$(UsingMicrosoftNETSdk)' == 'true' and '$(MSBuildProjectName)' != 'SteamWorkshopUploader'">
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game References (shared). Exclude SteamWorkshopUploader (standalone tool, no game refs). -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'SteamWorkshopUploader'">
    <Reference Include="0Harmony" HintPath="$(MSBuildThisFileDirectory)lib\0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(MSBuildThisFileDirectory)lib\Assembly-CSharp.dll" Private="false" Condition="'$(UsingMicrosoftNETSdk)' != 'true'" />
    <Reference Include="Assembly-CSharp" HintPath="$(MSBuildThisFileDirectory)lib\Assembly-CSharp.dll" Private="false" Publicize="true" Condition="'$(UsingMicrosoftNETSdk)' == 'true'" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(MSBuildThisFileDirectory)lib\Assembly-CSharp-firstpass.dll" Private="false" Condition="'$(UsingMicrosoftNETSdk)' != 'true'" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(MSBuildThisFileDirectory)lib\Assembly-CSharp-firstpass.dll" Private="false" Publicize="true" Condition="'$(UsingMicrosoftNETSdk)' == 'true'" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(MSBuildThisFileDirectory)lib\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(MSBuildThisFileDirectory)lib\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(MSBuildThisFileDirectory)lib\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(MSBuildThisFileDirectory)lib\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(MSBuildThisFileDirectory)lib\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(MSBuildThisFileDirectory)lib\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(MSBuildThisFileDirectory)lib\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(MSBuildThisFileDirectory)lib\UnityEngine.InputLegacyModule.dll" Private="false" />
  </ItemGroup>

  <!-- Standard content files (mod metadata) -->
  <ItemGroup>
    <None Remove="mod.yaml" />
    <None Remove="mod_info.yaml" />
    <Content Include="mod.yaml" CopyToOutputDirectory="Always" Condition="Exists('$(MSBuildProjectDirectory)\mod.yaml')" />
    <Content Include="mod_info.yaml" CopyToOutputDirectory="Always" Condition="Exists('$(MSBuildProjectDirectory)\mod_info.yaml')" />
    <Content Include="preview.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(MSBuildProjectDirectory)\preview.png')" />
  </ItemGroup>

</Project>
