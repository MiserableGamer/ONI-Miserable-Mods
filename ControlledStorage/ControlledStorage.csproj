<Project Sdk="Microsoft.NET.Sdk">
  <!-- 
    ControlledStorage - Unified storage control mod
    Packages from Directory.Build.props; refs/content here (BaseOutputPath for isolated paths).
    Combines: EmptyStorage, ControlledFiltering, CapacityControl
    Plus new features: Dupe/Sweeper delivery control, No-Sweep zones
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BaseOutputPath>$(MSBuildProjectDirectory)\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\</BaseIntermediateOutputPath>
    <AssemblyName>ControlledStorage</AssemblyName>
    <RootNamespace>ControlledStorage</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Packages and game refs: Directory.Build.props (except TextRenderingModule below) -->

  <ItemGroup>
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(MSBuildProjectDirectory)\..\lib\UnityEngine.TextRenderingModule.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="mod.yaml" CopyToOutputDirectory="Always" />
    <Content Include="mod_info.yaml" CopyToOutputDirectory="Always" />
    <Content Include="preview.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('preview.png')" />
  </ItemGroup>

  <!-- No-Sweep Zone tool icons (embedded for PUIUtils.LoadSprite) -->
  <ItemGroup>
    <EmbeddedResource Include="images\tool_icon.png" LogicalName="ControlledStorage.images.tool_icon.png" />
    <EmbeddedResource Include="images\visualizer_set.png" LogicalName="ControlledStorage.images.visualizer_set.png" />
    <EmbeddedResource Include="images\visualizer_cancel.png" LogicalName="ControlledStorage.images.visualizer_cancel.png" />
  </ItemGroup>

</Project>
