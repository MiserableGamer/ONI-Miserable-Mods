<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SteamWorkshopUploader</AssemblyName>
    <RootNamespace>SteamWorkshopUploader</RootNamespace>
    <OutputType>Exe</OutputType>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <!-- Do not inherit game refs / mod packages from Directory.Build.props -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Steamworks.NET" Version="12.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="steam_appid.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
