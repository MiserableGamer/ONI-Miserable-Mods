<Project>
  <!-- 
    Shared build targets for all ONIMiserableMods projects.
    Handles version increment (development branch only), ILRepack, and deployment.
  -->

  <PropertyGroup>
    <!-- Local mods folder for testing -->
    <LocalModsRoot>C:\Users\leomo\Documents\Klei\OxygenNotIncluded\mods\local\</LocalModsRoot>
    <LocalModFolder>$(LocalModsRoot)$(MSBuildProjectName)\</LocalModFolder>
    <!-- ReleaseModFolder: set in Directory.Build.props (default) or override in .csproj — do not set here (targets run after csproj). -->
    <!-- Build/version scripts live outside the repo -->
    <ScriptsRoot>D:\mcp\oni-serena\scripts\</ScriptsRoot>
  </PropertyGroup>

  <!-- Detect git branch before build -->
  <Target Name="DetectGitBranch" BeforeTargets="PreBuildEvent">
    <Exec Command="git rev-parse --abbrev-ref HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitBranch" />
    </Exec>
    <PropertyGroup>
      <GitBranch Condition="'$(GitBranch)' == ''">unknown</GitBranch>
      <IsDevelopmentBranch Condition="'$(GitBranch)' == 'development'">true</IsDevelopmentBranch>
      <IsDevelopmentBranch Condition="'$(GitBranch)' != 'development'">false</IsDevelopmentBranch>
    </PropertyGroup>
    <Message Text="[Build] Git branch: $(GitBranch), Configuration: $(Configuration)" Importance="high" />
  </Target>

  <!-- Pre-build: sync version from central project-versions.yaml to mod_info.yaml (development only).
    Catches manual major/minor/patch bumps so the build always uses the version from the central file. -->
  <Target Name="SyncVersionFromCentral" BeforeTargets="PreBuildEvent" DependsOnTargets="DetectGitBranch" Condition="'$(IsDevelopmentBranch)' == 'true' AND Exists('$(MSBuildThisFileDirectory)project-versions.yaml')">
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(ScriptsRoot)sync-version.ps1&quot; -ProjectName &quot;$(MSBuildProjectName)&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -SolutionDir &quot;$(MSBuildThisFileDirectory.TrimEnd('\'))&quot;" ContinueOnError="true" IgnoreExitCode="true" />
  </Target>

  <!-- After core output copy: put elements/ and anim/ next to the DLL. Runs before ILRepackMerge (explicit dependency). -->
  <Target Name="CopyModAssetsToOutput" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(MSBuildProjectName)' != 'MiserableUtils'">
    <ItemGroup>
      <_AnimForOutput Include="$(MSBuildProjectDirectory)\anim\**\*.*" Condition="Exists('$(MSBuildProjectDirectory)\anim')" />
      <_ElementsForOutput Include="$(MSBuildProjectDirectory)\elements\**\*.*" Condition="Exists('$(MSBuildProjectDirectory)\elements')" />
    </ItemGroup>
    <Copy SourceFiles="@(_AnimForOutput)" DestinationFolder="$(TargetDir)anim\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(_AnimForOutput)' != ''" />
    <Copy SourceFiles="@(_ElementsForOutput)" DestinationFolder="$(TargetDir)elements\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(_ElementsForOutput)' != ''" />
    <Message Text="[Build] Copied elements/anim to $(TargetDir)" Importance="high" Condition="'@(_ElementsForOutput)' != '' or '@(_AnimForOutput)' != ''" />
  </Target>

  <!-- Pre-ILRepack: Copy PLib and MiserableUtils from NuGet cache to output dir so ILRepack can find them.
    PrivateAssets="all" prevents NuGet from copying them automatically under netstandard2.1. -->
  <Target Name="CopyMergeDllsToOutput" AfterTargets="Build" DependsOnTargets="CopyModAssetsToOutput" Condition="'$(MSBuildProjectName)' != 'MiserableUtils'">
    <Copy SourceFiles="$(NuGetPackageRoot)plib\4.24.0\lib\netstandard2.1\PLib.dll" DestinationFolder="$(TargetDir)" Condition="Exists('$(NuGetPackageRoot)plib\4.24.0\lib\netstandard2.1\PLib.dll')" />
  </Target>

  <!-- Post-build: ILRepack to merge PLib and MiserableUtils into main DLL.
    We output directly to $(TargetPath) using a copy of the primary so the merged assembly
    keeps AssemblyName (e.g. "ControlledMods"). PLib uses GetName().Name for the mod identity
    and config path; /out:...dll.merged was causing the .dll suffix.
    MiserableUtils is a library only - skip ILRepack when building it. -->
  <Target Name="ILRepackMerge" AfterTargets="Build" DependsOnTargets="CopyMergeDllsToOutput" Condition="'$(MSBuildProjectName)' != 'MiserableUtils'">
    <ItemGroup>
      <MergeDll Include="$(TargetDir)PLib.dll" Condition="Exists('$(TargetDir)PLib.dll')" />
      <MergeDll Include="$(TargetDir)MiserableUtils.dll" Condition="Exists('$(TargetDir)MiserableUtils.dll') and '$(MSBuildProjectName)' != 'MiserableUtils'" />
    </ItemGroup>
    <PropertyGroup>
      <MergeDllList>@(MergeDll)</MergeDllList>
    </PropertyGroup>
    <Message Text="[Build] Merging @(MergeDll) into $(TargetFileName)" Importance="high" Condition="'$(MergeDllList)' != ''" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)$(TargetName)_primary.dll" Condition="'$(MergeDllList)' != ''" />
    <Exec Command="&quot;$(NuGetPackageRoot)ilrepack\2.0.44\tools\ILRepack.exe&quot; /ndebug /lib:&quot;$(MSBuildThisFileDirectory)lib&quot; /lib:&quot;$(NuGetPackageRoot)newtonsoft.json\13.0.4\lib\netstandard2.0&quot; /out:&quot;$(TargetPath)&quot; &quot;$(TargetDir)$(TargetName)_primary.dll&quot; @(MergeDll->'&quot;%(FullPath)&quot;', ' ')" Condition="'$(MergeDllList)' != ''" ContinueOnError="true" />
    <Delete Files="$(TargetDir)$(TargetName)_primary.dll" Condition="Exists('$(TargetDir)$(TargetName)_primary.dll')" />
    <Delete Files="@(MergeDll)" Condition="Exists('%(FullPath)')" />
  </Target>

  <!-- Release: mirror mod folder to repo release/.../ for Steam uploader & zips. elements/anim use robocopy (MSBuild globs are unreliable for ** on some hosts). -->
  <Target Name="StageModInReleaseFolder" AfterTargets="ILRepackMerge" Condition="'$(Configuration)' == 'Release' and '$(MSBuildProjectName)' != 'SteamWorkshopUploader' and '$(MSBuildProjectName)' != 'MiserableUtils'">
    <Message Text="[Build] Staging release folder for Steam: $(ReleaseModFolder)" Importance="high" />
    <RemoveDir Directories="$(ReleaseModFolder)" Condition="Exists('$(ReleaseModFolder)')" />
    <MakeDir Directories="$(ReleaseModFolder)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ReleaseModFolder)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\mod.yaml" DestinationFolder="$(ReleaseModFolder)" Condition="Exists('$(MSBuildProjectDirectory)\mod.yaml')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\mod_info.yaml" DestinationFolder="$(ReleaseModFolder)" Condition="Exists('$(MSBuildProjectDirectory)\mod_info.yaml')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\preview.png" DestinationFolder="$(ReleaseModFolder)" Condition="Exists('$(MSBuildProjectDirectory)\preview.png')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\preview.jpg" DestinationFolder="$(ReleaseModFolder)" Condition="Exists('$(MSBuildProjectDirectory)\preview.jpg')" />
    <!-- Folder trees: avoid MSBuild ** globs and robocopy exit codes (1 = success). Copy-Item is reliable. -->
    <Exec Command="powershell -NoProfile -NonInteractive -Command &quot;Copy-Item -LiteralPath '$(MSBuildProjectDirectory)\elements' -Destination '$(ReleaseModFolder)' -Recurse -Force -ErrorAction Stop&quot;" Condition="Exists('$(MSBuildProjectDirectory)\elements')" />
    <Exec Command="powershell -NoProfile -NonInteractive -Command &quot;Copy-Item -LiteralPath '$(MSBuildProjectDirectory)\anim' -Destination '$(ReleaseModFolder)' -Recurse -Force -ErrorAction Stop&quot;" Condition="Exists('$(MSBuildProjectDirectory)\anim')" />
  </Target>

  <!-- Post-build: Deploy to local mods folder for testing (development only; exclude SteamWorkshopUploader, MiserableUtils) -->
  <Target Name="DeployToLocalMods" AfterTargets="ILRepackMerge" DependsOnTargets="DetectGitBranch" Condition="'$(IsDevelopmentBranch)' == 'true' and '$(MSBuildProjectName)' != 'SteamWorkshopUploader' and '$(MSBuildProjectName)' != 'MiserableUtils'">
    <Message Text="[Build] Deploying to $(LocalModFolder)" Importance="high" />
    
    <!-- Create folder if needed -->
    <MakeDir Directories="$(LocalModFolder)" Condition="!Exists('$(LocalModFolder)')" />
    
    <!-- Copy main DLL -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(LocalModFolder)" />
    
    <!-- Copy mod metadata files -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\mod.yaml" DestinationFolder="$(LocalModFolder)" Condition="Exists('$(MSBuildProjectDirectory)\mod.yaml')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\mod_info.yaml" DestinationFolder="$(LocalModFolder)" Condition="Exists('$(MSBuildProjectDirectory)\mod_info.yaml')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\preview.png" DestinationFolder="$(LocalModFolder)" Condition="Exists('$(MSBuildProjectDirectory)\preview.png')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\preview.jpg" DestinationFolder="$(LocalModFolder)" Condition="Exists('$(MSBuildProjectDirectory)\preview.jpg')" />
    
    <!-- Copy anim folder if it exists -->
    <ItemGroup>
      <AnimFiles Include="$(MSBuildProjectDirectory)\anim\**\*.*" Condition="Exists('$(MSBuildProjectDirectory)\anim')" />
    </ItemGroup>
    <Copy SourceFiles="@(AnimFiles)" DestinationFolder="$(LocalModFolder)anim\%(RecursiveDir)" Condition="'@(AnimFiles)' != ''" />
    <ItemGroup>
      <ModElementFiles Include="$(MSBuildProjectDirectory)\elements\**\*.*" Condition="Exists('$(MSBuildProjectDirectory)\elements')" />
    </ItemGroup>
    <Copy SourceFiles="@(ModElementFiles)" DestinationFolder="$(LocalModFolder)elements\%(RecursiveDir)" Condition="'@(ModElementFiles)' != ''" />
    
    <!-- Cleanup: Remove stray merged DLLs if they got copied -->
    <Delete Files="$(LocalModFolder)PLib.dll" Condition="Exists('$(LocalModFolder)PLib.dll')" />
    <Delete Files="$(LocalModFolder)MiserableUtils.dll" Condition="Exists('$(LocalModFolder)MiserableUtils.dll')" />
  </Target>

  <!-- Version increment: After successful build + deploy (development + Debug only). Runs only when build succeeded.
    Increments build number in project-versions.yaml (source of truth) then syncs to mod_info.yaml. -->
  <Target Name="IncrementVersionAfterBuild" AfterTargets="DeployToLocalMods" DependsOnTargets="DetectGitBranch" Condition="'$(IsDevelopmentBranch)' == 'true' AND '$(Configuration)' == 'Debug' AND '$(MSBuildProjectName)' != 'MiserableUtils'">
    <Message Text="[Build] Build succeeded - incrementing version (development + Debug)" Importance="high" />
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(ScriptsRoot)increment-version.ps1&quot; -ProjectName &quot;$(MSBuildProjectName)&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -SolutionDir &quot;$(MSBuildThisFileDirectory.TrimEnd('\'))&quot;" ContinueOnError="true" IgnoreExitCode="true" />
    <!-- Sync updated mod_info.yaml to local mod folder so both source and deployed copy match -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\mod_info.yaml" DestinationFolder="$(LocalModFolder)" Condition="Exists('$(MSBuildProjectDirectory)\mod_info.yaml')" />
  </Target>

</Project>
