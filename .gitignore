# PowerShell scripts (build and local operation scripts - not needed for mod functionality)
*.ps1
release-mod.ps1
release-mod.cmd
create-indexed-junctions.ps1

# Local operation markdown files (not user-facing documentation)
UPLOAD_INSTRUCTIONS.md
STEAM_UPLOAD_README.md
**/ORGANIZE_FILES.md

# Encrypted credential files (should never be committed)
steam_credentials.encrypted

# Steam Workshop VDF files (temporary files generated by upload script)
*.vdf

# Release folder - ignore temporary folders but allow zip files
release/*/
!release/*.zip
/.github/RELEASE_GUIDE.md

# Local development rules file (contains local paths and development workflow)
DEV_RULES.txt
.cursorrules

# Indexed reference code (junctions to \\...\indexed\source|prime|reference)
/source/
/prime/
/reference/
/.cursor/commands/comment-cleanup.md

# Local/IDE and tooling (not for distribution)
.claude/
.serena/
/jarvis/

# Scripts moved to c:\oni-serena\scripts (backed up separately). Launchers at repo root.
/scripts/

# Memory Bank and AI assistant context (lives locally at C:\oni-memory-bank)
memory-bank/
